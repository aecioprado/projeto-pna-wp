# ------------------------------------------------------------
# Projeto PNA – este repositório guarda SOMENTE o código próprio
# (tema, plugin, configs). O WordPress em si é criado pelo wp-env
# e nunca entra no Git.
# ------------------------------------------------------------

# Dependências
node_modules/
vendor/

# Configurações locais / segredos (NUNCA versionar)
.env
.env.*
!.env.example
wp-config.php
.wp-env.override.json
auth.json

# Dados (LGPD: nunca versionar banco ou arquivos de usuários)
*.sql
*.sql.gz
uploads/

# Builds e caches
build/
dist/
.cache/
*.log

# Sistema operacional / editores
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
